# Optional overrides. The MVP contains safe public Supabase defaults.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Required only to enable /admin company invitations.
SUPABASE_SECRET_KEY=

# Server-only Resend settings. Required for sending messages to contacts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional reply-to address, for example suporte@aetherworks.com.br.
RESEND_REPLY_TO=

# Optional no-Meta WhatsApp Web bridge (WPPConnect Server)
WPP_BRIDGE_URL=
WPP_BRIDGE_TOKEN=
# Optional Evolution API (Baileys) mobile pairing without Meta API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

